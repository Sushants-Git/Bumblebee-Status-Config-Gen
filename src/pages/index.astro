---
import InputField from "../components/InputField";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Bumblebee Status Config Generator</title>
  </head>
  <body>
    <div class="container">
      <InputField client:load />
    </div>
  </body>
</html>

<script></script>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap");
  @import url("https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@100;200;300;400;500;600;700;800;900&display=swap");

  * {
    box-sizing: border-box;
  }

  :root {
    --bg-color: #101010;
    --primary-color: #ffffff;
    --primary-font: "Lexend Deca", sans-serif;
    --secondary-font: "Space Grotesk", sans-serif;
    --border-color: #282828;
    --muted-color: #9a9a9a;
    --error-color: #ff6b6b;
  }

  body {
    background-color: var(--bg-color);
    color: var(--primary-color);
    font-family: var(--primary-font);
    padding-bottom: 10vh;
  }

  .github-logo a {
    text-decoration: none;
    color: var(--primary-color);
    display: flex;
    gap: 10px;
    position: fixed;
    bottom: 20px;
    left: 20px;
    border: 1px solid var(--border-color);
    border-radius: 5px;
    padding: 0.5rem;
    box-sizing: content-box;
    cursor: pointer;
  }

  .github-logo svg {
    width: 1rem;
    height: 1rem;
  }

  .github-logo a:hover {
    background-color: var(--border-color);
  }

  .container {
    /* width: 70vw; */
    height: max-content;
    margin: auto;
    margin-top: 7vh;
  }

  input {
    font-size: 1.25rem;
    background-color: var(--bg-color);
    border: none;
    border-radius: 5px;
    padding: 0.5rem 1rem;
    color: inherit;
    font-family: inherit;
    border: 1px solid var(--border-color);
    max-width: 390px;
  }

  select {
    font-size: 1.25rem;
    background-color: var(--bg-color);
    border: none;
    border-radius: 5px;
    padding: 0.5rem 1rem;
    color: inherit;
    font-family: inherit;
    border: 1px solid var(--border-color);
    min-width: 390px;

    -moz-appearance: none; /* Firefox */
    -webkit-appearance: none; /* Safari and Chrome */
    appearance: none;
  }

  .tags-wrapper {
    margin: auto;
    width: max-content;
    display: flex;
    gap: 20px;
    font-size: 1rem;
  }

  .tags-wrapper label {
    font-size: 1.25rem;
  }

  #tags-input-wrapper {
    width: 500px;
  }

  .tags-created {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  .tags-created label {
    visibility: hidden;
    user-select: none;
  }

  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    gap: 30px;
    margin-bottom: 10px;
    justify-content: space-between;
  }

  .input-wrapper input {
    width: 390px;
  }

  /* .tags-wrapper input {
    background-color: var(--bg-color);
    border: none;
    border-radius: 5px;
    padding: 0.5rem 1rem;
    color: inherit;
    font-family: inherit;
    font-size: 1.25rem;
    border: 1px solid var(--border-color);
  } */

  .tag {
    background-color: var(--primary-color);
    color: var(--bg-color);
  }

  .autocomplete-wrapper {
    position: absolute;
    z-index: 100;
    top: 0;
    display: flex;
    width: 100%;
    margin-top: 50px;
    justify-content: space-between;
  }

  .autocomplete-results {
    width: 390px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .autocomplete-results li {
    border: 1px solid var(--border-color);
    padding: 0.5rem 1rem;
    background-color: var(--bg-color);
    color: var(--primary-color);
    font-size: 1.25rem;
    cursor: pointer;
  }

  .autocomplete-results li:nth-child(1) {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
  }

  .autocomplete-results li:nth-last-child(1) {
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
  }

  .autocomplete-results li.active {
    background-color: var(--primary-color);
    color: var(--bg-color);
  }

  .autocomplete-wrapper label {
    visibility: hidden;
    user-select: none;
  }

  #created-tags-wrapper {
    display: flex;
    flex-wrap: wrap;
    justify-content: left;
    align-items: center;
    width: 100%;
    gap: 5px;
  }

  #created-tags-wrapper .tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: inherit;
    padding: 4px 9px;
    border-radius: 3px;
    font-size: 1.25rem;
    border: 1px solid var(--border-color);
    background-color: var(--bg-color);
    color: var(--primary-color);
    cursor: pointer;
  }

  .tag-remove {
    color: var(--muted-color);
    font-size: 1rem;
    line-height: 1;
  }

  #created-tags-wrapper .tag:hover .tag-remove,
  #created-tags-wrapper .tag:focus-visible .tag-remove {
    color: inherit;
  }

  #created-tags-wrapper .tag:hover,
  #created-tags-wrapper .tag:focus-visible {
    border: 1px solid var(--primary-color);
    background: var(--primary-color);
    color: var(--bg-color);
  }

  .module-wrapper {
    margin-top: 30px;
    border-top: 2px dashed var(--border-color);
    padding-top: 30px;
  }

  .module-wrapper:nth-child(1) {
    border-top: none;
  }

  .name {
    display: inline-block;
    font-size: 1.25rem;
    font-weight: bold;
    margin-bottom: 7px;
  }

  .description {
    /* display: inline-block; */
    font-size: 1rem;
    margin-bottom: 14px;
  }

  .theme-image {
    margin-top: 20px;
    display: flex;
    width: max-content;
    justify-self: center;
    align-items: center;
    margin-left: auto;
    margin-right: auto;
    max-width: 100%;
    border: 1px dashed var(--border-color);
    padding: 0.5rem 1rem;
  }

  .theme-image img {
    /* width: 50vw; */
    max-width: 100%;
    height: 10%;
    object-fit: cover;
  }

  .output-text {
    position: relative;
    width: max-content;
    max-width: 100%;
    margin: 30px auto;
  }

  .output-text pre {
    font-family: var(--secondary-font);
    line-height: 1.2;
    font-size: 1rem;
    margin: 0;
    overflow-x: auto;
    tab-size: 4;
    border: 2px dashed var(--border-color);
    padding: 1rem 4.5rem 1rem 2rem;
  }

  .copy-button {
    position: absolute;
    bottom: 15px;
    right: 15px;
    border: 1px solid var(--border-color);
    height: 40px;
    width: 40px;
    color: var(--primary-color);
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-color);
    border-radius: 9px;
    padding: 5px;
  }

  .copy-button:hover {
    background-color: var(--border-color);
  }

  .parameters-wrapper {
    width: min(70vw, 1000px);
    margin: auto;
  }

  .dependencies {
    font-size: 1.25rem;
    font-weight: bold;
    margin-right: 1rem;
  }

  .dependencies-type {
    display: flex;
  }

  .box-wrappers {
    display: flex;
    flex-wrap: wrap;
    margin-top: 10px;
    gap: 20px;
  }

  .green-color-div,
  .blue-color-div,
  .white-color-div {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 5px;
  }

  .green-color-div .box {
    background-color: #00ff00;
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .blue-color-div .box {
    background-color: #48baff;
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .white-color-div .box {
    background-color: var(--primary-color);
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .contrib-links {
    text-decoration: none;
    color: #48baff;
  }

  .parameters-name {
    font-size: 1rem;
    font-weight: bold;
    margin-bottom: 7px;
  }

  .parameters-input-wrappers input {
    font-size: 1rem;
  }

  .name-and-description-wrapper {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-bottom: 16px;
  }

  .parameters-input-wrappers .name-and-description {
    margin-bottom: 10px;
    margin-top: 10px;
  }

  .change-default-wrapper {
    display: flex;
    align-items: center;
    align-items: center;
    gap: 5px;
    margin-bottom: 10px;
  }

  .change-default {
    margin-top: 10px;
    margin-bottom: 10px;
  }

  .example {
    margin-left: 10px;
    color: var(--muted-color);
  }

  .parameters-input-wrappers .name-and-description {
    display: block;
    overflow-wrap: anywhere;
  }

  .module-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
  }

  .reorder-buttons {
    display: flex;
    gap: 5px;
    flex-shrink: 0;
  }

  .reorder-buttons button {
    width: 32px;
    height: 32px;
    font-size: 1rem;
    font-family: inherit;
    color: var(--primary-color);
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: 5px;
    cursor: pointer;
  }

  .reorder-buttons button:hover:not(:disabled) {
    background-color: var(--border-color);
  }

  .reorder-buttons button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .input-error {
    min-height: 1.2em;
    margin: -4px 0 6px auto;
    width: 390px;
    max-width: 100%;
    font-size: 0.9rem;
    color: var(--error-color);
  }

  .input-error:empty {
    display: none;
  }

  @media (max-width: 700px) {
    body {
      margin: 0;
    }

    .container {
      margin-top: 4vh;
      padding: 0 16px;
    }

    .tags-wrapper,
    #tags-input-wrapper {
      width: 100%;
    }

    .input-wrapper {
      flex-direction: column;
      align-items: stretch;
      gap: 6px;
    }

    .input-wrapper input,
    select {
      width: 100%;
      min-width: 0;
      max-width: none;
    }

    .autocomplete-wrapper {
      top: 100%;
      margin-top: 4px;
    }

    .autocomplete-wrapper label,
    .tags-created label,
    .dependencies-spacer {
      display: none;
    }

    .autocomplete-wrapper > div,
    .autocomplete-results {
      width: 100%;
    }

    .autocomplete-results li {
      overflow-wrap: anywhere;
    }

    .input-error {
      width: 100%;
      margin-top: 0;
    }

    .output-text pre {
      font-size: 0.85rem;
      padding: 1rem 3.5rem 1rem 1rem;
    }

    .parameters-wrapper {
      width: 100%;
    }

    .parameters-input-wrappers input {
      width: 100%;
      max-width: none;
    }

    .example {
      display: block;
      margin: 6px 0 0;
    }

    .github-logo a {
      bottom: 12px;
      left: 12px;
      background-color: var(--bg-color);
    }
  }
</style>
