---
import InputField from "../components/InputField";
import "@fontsource-variable/lexend-deca";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/600.css";
import "../styles/global.css";

const description =
  "Build a bumblebee-status bar config for i3 and sway: pick modules, tweak their parameters, preview themes and copy the result.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#111111" />
    <meta property="og:title" content="Bumblebee Status Config Generator" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>Bumblebee Status Config Generator</title>
  </head>
  <body>
    <header class="site-header">
      <h1>bumblebee-status <span>config generator</span></h1>
      <nav>
        <a href="https://bumblebee-status.readthedocs.io/" target="_blank" rel="noopener noreferrer">docs</a>
        <a href="https://github.com/Sushants-Git/Bumblebee-Status-Config-Gen" target="_blank" rel="noopener noreferrer">source</a>
      </nav>
    </header>
    <main class="container">
      <InputField client:load />
    </main>
  </body>
</html>
